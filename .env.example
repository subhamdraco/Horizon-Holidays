# Copy to `.env` (Vite reads VITE_* at build time)

# WordPress REST API root (no trailing slash). When set, tours load from WP on app start.
# Example: https://cms.example.com/wp-json
VITE_WORDPRESS_REST_URL=

# Public URL of this React site (no trailing slash) — used for canonical & OG URLs.
# Example: https://www.example.com
VITE_PUBLIC_SITE_URL=
